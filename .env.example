# Intelligent Log Analysis and Threat Detection - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Path to the 6,000,000-record dataset CSV
DATASET_PATH=data/cybersecurity_threat_detection_logs.csv

# Backend Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000

# Frontend Configuration (leave empty to use Vite proxy /api -> http://localhost:5000)
# VITE_API_URL=http://localhost:5000/api
